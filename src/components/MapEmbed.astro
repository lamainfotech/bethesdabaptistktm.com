---
import { CONTACT } from '../lib/site';
import { mapsEmbedSrc } from '../lib/links';

interface Props {
  title: string;
  class?: string;
}

const { title, class: className = 'h-80' } = Astro.props;
---

<div class:list={['overflow-hidden rounded-2xl bg-stone-100 shadow-sm ring-1 ring-stone-200', className]}>
  <iframe
    src={mapsEmbedSrc(CONTACT.mapsQuery)}
    class="h-full w-full"
    style="border:0"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title={title}
  ></iframe>
</div>
