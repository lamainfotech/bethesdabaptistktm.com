---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, intro, align = 'left' } = Astro.props;
---

<div class:list={[align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl']}>
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-700">{eyebrow}</p>}
  <h2 class="mt-2 text-3xl font-bold text-stone-900 sm:text-4xl">{title}</h2>
  {intro && <p class="mt-4 text-lg text-stone-600">{intro}</p>}
</div>
