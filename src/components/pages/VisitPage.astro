---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import SectionHeading from '../SectionHeading.astro';
import IconBadge from '../IconBadge.astro';
import Icon from '../Icon.astro';
import MapEmbed from '../MapEmbed.astro';
import CtaBand from '../CtaBand.astro';
import ExampleNotice from '../ExampleNotice.astro';
import type { IconName } from '../Icon.astro';
import { CONTACT } from '../../lib/site';
import { localHref, mapsHref } from '../../lib/links';
import type { Lang } from '../../lib/ui';
import heroImage from '../../assets/images/hero-kathmandu.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// "What to expect" is not yet translated; the Nepali page omits it.
const copy = {
  en: {
    title: 'Service Times & Location',
    description: 'Service times and location for Bethesda Baptist Church in Dhumbarahi, Kathmandu.',
    heroAlt: 'View over Kathmandu valley',
    eyebrow: "We'd love to meet you",
    intro: 'Everything you need to know before your first Saturday with us.',
    scheduleTitle: 'Weekly Schedule',
    schedule: [
      { day: 'Sat', name: 'Saturday Bible Study', time: '9:00 AM' },
      { day: 'Sat', name: 'Saturday Worship', time: '10:00 AM' },
      { day: 'Wed', name: 'Wednesday Prayer Meeting', time: '6:00 PM' },
    ],
    expectEyebrow: 'Your first visit',
    expectTitle: 'What to expect',
    expect: [
      { icon: 'sparkles', title: 'Come as you are', body: 'Dress is casual — no need to dress up.' },
      { icon: 'users', title: 'Families welcome', body: 'Children and families are welcome at every service.' },
      { icon: 'clock', title: 'Arrive a little early', body: 'Find parking and settle in before things begin.' },
    ] as { icon: IconName; title: string; body: string }[],
    locationEyebrow: 'Find us',
    locationTitle: 'Location',
    directions: 'Get directions',
    mapTitle: 'Map showing Bethesda Baptist Church location',
    ctaTitle: 'Have a question before you come?',
    ctaText: "Call or email us — we're happy to help you find your way.",
    ctaButton: 'Contact Us',
  },
  ne: {
    title: 'आराधना समय र ठेगाना',
    description: 'बेथेस्दा ब्याप्टिष्ट चर्चको आराधना समय र ठेगाना।',
    heroAlt: 'काठमाडौं उपत्यकाको दृश्य',
    eyebrow: 'हामीसँग जोडिनुहोस्',
    intro: undefined,
    scheduleTitle: 'साप्ताहिक तालिका',
    schedule: [
      { day: 'शनि', name: 'शनिबार बाइबल अध्ययन', time: 'बिहान ९:०० बजे' },
      { day: 'शनि', name: 'शनिबार आराधना', time: 'बिहान १०:०० बजे' },
      { day: 'बुध', name: 'बुधबार प्रार्थना सभा', time: 'साँझ ६:०० बजे' },
    ],
    expectEyebrow: undefined,
    expectTitle: undefined,
    expect: null,
    locationEyebrow: 'ठेगाना',
    locationTitle: 'ठेगाना',
    directions: 'नक्सामा हेर्नुहोस्',
    mapTitle: 'बेथेस्दा ब्याप्टिष्ट चर्चको स्थान देखाउने नक्सा',
    ctaTitle: 'केही प्रश्न छ?',
    ctaText: 'हामीलाई फोन वा इमेल गर्नुहोस्।',
    ctaButton: 'सम्पर्क',
  },
}[lang];
---

<BaseLayout lang={lang} title={copy.title} description={copy.description}>
  <PageHero title={copy.title} image={heroImage} alt={copy.heroAlt} eyebrow={copy.eyebrow} intro={copy.intro} />

  <section class="mx-auto max-w-6xl px-4 py-20">
    <div class:list={['grid gap-12', copy.expect && 'lg:grid-cols-5']}>
      <!-- Schedule -->
      <div class:list={[copy.expect ? 'lg:col-span-3' : 'mx-auto w-full max-w-2xl']}>
        <div class="overflow-hidden rounded-2xl bg-white shadow-lg ring-1 ring-stone-200">
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 bg-brand-700 px-6 py-5 text-white">
            <h2 class="flex items-center gap-2 text-xl font-semibold">
              <Icon name="calendar" class="h-5 w-5 text-brand-200" />
              {copy.scheduleTitle}
            </h2>
            <ExampleNotice lang={lang} />
          </div>
          <ul class="divide-y divide-stone-200">
            {copy.schedule.map((item) => (
              <li class="flex items-center gap-4 px-6 py-5">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-sm font-semibold uppercase text-brand-700">
                  {item.day}
                </span>
                <span class="flex-1 font-medium text-stone-900">{item.name}</span>
                <span class="font-serif text-lg font-semibold text-brand-700">{item.time}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- What to expect -->
      {copy.expect && (
        <div class="lg:col-span-2">
          <SectionHeading eyebrow={copy.expectEyebrow} title={copy.expectTitle!} />
          <ul class="mt-8 space-y-6">
            {copy.expect.map((item) => (
              <li class="flex gap-4">
                <IconBadge name={item.icon} />
                <div>
                  <h3 class="font-semibold text-stone-900">{item.title}</h3>
                  <p class="mt-1 text-sm text-stone-600">{item.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- Location -->
  <section class="bg-cream py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 lg:grid-cols-3">
      <div>
        <SectionHeading eyebrow={copy.locationEyebrow} title={copy.locationTitle} />
        <p class="mt-5 flex items-start gap-2 text-lg text-stone-800">
          <Icon name="pin" class="mt-1 h-5 w-5 shrink-0 text-brand-700" />
          {CONTACT.address}
        </p>
        <a href={mapsHref(CONTACT.mapsQuery)} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 rounded-lg bg-brand-700 px-5 py-2.5 font-medium text-white shadow-sm transition-colors hover:bg-brand-800">
          {copy.directions}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
      <MapEmbed title={copy.mapTitle} class="h-96 lg:col-span-2" />
    </div>
  </section>

  <div class="pt-20">
    <CtaBand title={copy.ctaTitle} text={copy.ctaText} button={copy.ctaButton} href={localHref(lang, '/contact/')} />
  </div>
</BaseLayout>
