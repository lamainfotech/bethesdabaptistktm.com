---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import SectionHeading from '../SectionHeading.astro';
import IconBadge from '../IconBadge.astro';
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';
import { CONTACT } from '../../lib/site';
import type { Lang } from '../../lib/ui';
import heroImage from '../../assets/images/giving-praying-hands.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  en: {
    title: 'Giving',
    description: 'Support the ministry of Bethesda Baptist Church, Kathmandu.',
    heroAlt: 'Praying hands',
    eyebrow: 'Generosity',
    intro: 'Supporting the ministry of the gospel in Kathmandu and beyond.',
    quote:
      'We covenant to give cheerfully and faithfully of our time, abilities, and resources for the support of the ministry, the care of the needy, and the spread of the gospel to all nations.',
    quoteSource: 'from our Church Covenant',
    waysEyebrow: 'How to give',
    waysTitle: 'Ways to Give',
    ways: [
      { icon: 'users', title: 'In Person', body: 'Give during a Saturday service, or hand your gift directly to Pastor Hari KC or a deacon.' },
      { icon: 'bank', title: 'Bank Transfer', body: 'Bank account details are being finalized — check back soon or contact us for the current information.' },
      { icon: 'globe', title: 'Online', body: "We're working on an online giving option. This page will be updated once it's ready." },
    ] as { icon: IconName; title: string; body: string }[],
    questionsTitle: 'Questions about giving?',
    questionsText: "We're glad to help — send us an email and we'll get back to you.",
    questionsButton: 'Email us',
  },
  ne: {
    title: 'दान',
    description: 'बेथेस्दा ब्याप्टिष्ट चर्चको सेवाकार्यलाई सहयोग गर्नुहोस्।',
    heroAlt: 'प्रार्थना गर्दै भएका हातहरू',
    eyebrow: undefined,
    intro: undefined,
    quote: undefined,
    quoteSource: undefined,
    waysEyebrow: undefined,
    waysTitle: 'दान दिने तरिकाहरू',
    ways: [
      { icon: 'users', title: 'व्यक्तिगत रूपमा', body: 'शनिबार सेवामा वा पास्टर वा डिकनलाई प्रत्यक्ष दिनुहोस्।' },
      { icon: 'bank', title: 'बैंक स्थानान्तरण', body: 'बैंक विवरण चाँडै उपलब्ध हुनेछ।' },
      { icon: 'globe', title: 'अनलाइन', body: 'अनलाइन दान विकल्पमा काम भइरहेको छ।' },
    ] as { icon: IconName; title: string; body: string }[],
    questionsTitle: 'प्रश्नका लागि सम्पर्क गर्नुहोस्',
    questionsText: undefined,
    questionsButton: 'इमेल गर्नुहोस्',
  },
}[lang];
---

<BaseLayout lang={lang} title={copy.title} description={copy.description}>
  <PageHero title={copy.title} image={heroImage} alt={copy.heroAlt} eyebrow={copy.eyebrow} intro={copy.intro} imagePosition="50% 38%" />

  {copy.quote && (
    <section class="mx-auto max-w-3xl px-4 pt-20 text-center">
      <blockquote class="font-serif text-2xl italic leading-relaxed text-stone-800">{copy.quote}</blockquote>
      <p class="mt-5 text-sm font-medium uppercase tracking-wider text-brand-700">{copy.quoteSource}</p>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-4 py-20">
    <SectionHeading eyebrow={copy.waysEyebrow} title={copy.waysTitle} align="center" />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {copy.ways.map((way, i) => (
        <div class="relative rounded-2xl bg-white p-7 shadow-sm ring-1 ring-stone-200">
          <span class="absolute right-6 top-5 font-serif text-5xl font-bold text-brand-50" aria-hidden="true">{i + 1}</span>
          <IconBadge name={way.icon} />
          <h3 class="relative mt-5 text-lg font-semibold text-stone-900">{way.title}</h3>
          <p class="relative mt-2 text-sm text-stone-600">{way.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-start gap-5 rounded-2xl bg-cream p-8 ring-1 ring-stone-200 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-xl font-semibold text-stone-900">{copy.questionsTitle}</h2>
        {copy.questionsText && <p class="mt-1 text-stone-600">{copy.questionsText}</p>}
      </div>
      <a href={`mailto:${CONTACT.email}`} class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-brand-700 px-5 py-2.5 font-medium text-white shadow-sm hover:bg-brand-800">
        <Icon name="mail" class="h-4 w-4" />
        {copy.questionsButton}
      </a>
    </div>
  </section>
</BaseLayout>
