---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { Lang } from '../../lib/ui';
import heroImage from '../../assets/images/giving-praying-hands.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entry = (await getEntry('giving', lang))!;
const page = entry.data;
const { Content } = await render(entry);
---

<BaseLayout lang={lang} title={page.title} description={page.description}>
  <PageHero
    title={page.heading}
    image={heroImage}
    alt={page.heroAlt}
    eyebrow={page.eyebrow}
    intro={page.introText}
    imagePosition="50% 38%"
  />

  {(page.bankName || page.accountName || page.accountNumber || page.qrImage) && (
    <section class="mx-auto max-w-6xl px-4 pt-12">
      <div class="flex flex-col gap-8 rounded-2xl bg-white p-7 shadow-sm ring-1 ring-stone-200 sm:flex-row sm:items-center sm:justify-between">
        <dl class="space-y-3">
          {page.bankName && <div><dt class="font-semibold text-stone-900">{page.bankLabel}</dt><dd class="text-stone-700">{page.bankName}</dd></div>}
          {page.accountName && <div><dt class="font-semibold text-stone-900">{page.accountNameLabel}</dt><dd class="text-stone-700">{page.accountName}</dd></div>}
          {page.accountNumber && <div><dt class="font-semibold text-stone-900">{page.accountNumberLabel}</dt><dd class="text-stone-700">{page.accountNumber}</dd></div>}
        </dl>
        {page.qrImage && <Image src={page.qrImage} alt={page.qrImageAlt ?? ''} class="h-48 w-48 object-contain" />}
      </div>
    </section>
  )}

  {entry.body?.trim() && <Content />}
</BaseLayout>
