---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import IconBadge from '../IconBadge.astro';
import Icon from '../Icon.astro';
import { getEntry } from 'astro:content';
import MapEmbed from '../MapEmbed.astro';
import { mapsHref } from '../../lib/links';
import type { Lang } from '../../lib/ui';
import heroImage from '../../assets/images/hero-kathmandu.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entry = (await getEntry('contact', lang))!;
const page = entry.data;
const phones = [page.phone1, page.phone2].filter((phone): phone is string => Boolean(phone));

const tel = (phone: string) => `tel:${phone.replace(/\s|-/g, '')}`;
---

<BaseLayout lang={lang} title={page.title} description={page.description}>
  <PageHero
    title={page.heading}
    image={heroImage}
    alt={page.heroAlt}
    eyebrow={page.eyebrow}
    intro={page.introText}
  />

  <section class="mx-auto max-w-6xl px-4 py-20">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-2xl bg-white p-7 shadow-sm ring-1 ring-stone-200">
        <IconBadge name="pin" />
        <h2 class="mt-5 text-lg font-semibold text-stone-900">{page.addressLabel}</h2>
        <p class="mt-2 text-stone-700">{page.address}</p>
        <a href={mapsHref(page.address)} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-700 hover:text-brand-800">
          {page.mapLinkLabel} <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>

      <div class="rounded-2xl bg-white p-7 shadow-sm ring-1 ring-stone-200">
        <IconBadge name="phone" />
        <h2 class="mt-5 text-lg font-semibold text-stone-900">{page.phoneLabel}</h2>
        <ul class="mt-2 space-y-1">
          {phones.map((phone) => (
            <li><a href={tel(phone)} class="text-stone-700 hover:text-brand-700">{phone}</a></li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl bg-white p-7 shadow-sm ring-1 ring-stone-200">
        <IconBadge name="mail" />
        <h2 class="mt-5 text-lg font-semibold text-stone-900">{page.emailLabel}</h2>
        {page.email && <a href={`mailto:${page.email}`} class="mt-2 block break-all text-stone-700 hover:text-brand-700">{page.email}</a>}
        {page.email && <a href={`mailto:${page.email}`} class="mt-4 inline-flex items-center gap-2 rounded-lg bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800">
          {page.emailButtonLabel} <Icon name="arrow" class="h-4 w-4" />
        </a>}
      </div>
    </div>

    {page.mapEmbedUrl && (
      <MapEmbed
        title={page.mapTitle}
        embedUrl={page.mapEmbedUrl}
        class="mt-10 h-[28rem]"
      />
    )}
  </section>
</BaseLayout>
