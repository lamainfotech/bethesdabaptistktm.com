---
import Icon from './Icon.astro';

interface Props {
  title: string;
  text: string;
  button: string;
  href: string;
}

const { title, text, button, href } = Astro.props;
---

<section class="px-4 pb-20">
  <div class="relative mx-auto max-w-6xl overflow-hidden rounded-3xl bg-brand-800 px-8 py-12 text-white shadow-xl sm:px-12">
    <svg class="absolute -right-10 -top-10 h-64 w-64 text-white/5" viewBox="0 0 64 64" aria-hidden="true">
      <path d="M28 4h8v16h16v8H36v32h-8V28H12v-8h16z" fill="currentColor" />
    </svg>
    <div class="relative flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl">
        <h2 class="text-2xl font-bold sm:text-3xl">{title}</h2>
        <p class="mt-3 text-brand-100">{text}</p>
      </div>
      <a href={href} class="inline-flex shrink-0 items-center gap-2 self-start rounded-lg bg-white px-6 py-3 font-medium text-brand-800 shadow transition-colors hover:bg-brand-50 md:self-auto">
        {button}
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
