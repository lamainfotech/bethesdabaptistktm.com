---
import { getCollection } from 'astro:content';
import bannerImage from '../../assets/images/open-bible.jpg';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExampleNotice from '../../components/ExampleNotice.astro';
import SermonList from '../../components/SermonList.astro';

const sermons = (await getCollection('sermons')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  lang="en"
  title="Sermons"
  description="Sermons from Bethesda Baptist Church, Kathmandu."
>
  <PageHero title="Sermons" image={bannerImage} alt="An open Bible" eyebrow="Listen & watch" intro="Messages from the preaching of God's Word at Bethesda." />

  <section class="mx-auto max-w-3xl px-4 py-14">
    {sermons.length === 0 ? (
      <div class="rounded-lg border border-dashed border-stone-300 p-5 text-stone-600">
        <p class="font-medium text-stone-800">Sermons coming soon</p>
        <p class="mt-1 text-sm">We're setting up recordings for past and future messages. Check back soon.</p>
      </div>
    ) : (
      <>
        <div>
          <ExampleNotice lang="en" variant="banner">
            <p>These are example listings — real sermon videos will replace them soon.</p>
          </ExampleNotice>
        </div>
        <SermonList lang="en" sermons={sermons} />
      </>
    )}
  </section>
</BaseLayout>
