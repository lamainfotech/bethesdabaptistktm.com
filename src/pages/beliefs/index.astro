---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import bannerImage from '../../assets/images/open-bible.jpg';

const entry = await getEntry('faith', 'en');
const { Content } = await render(entry!);
---

<BaseLayout
  lang="en"
  title="Statement of Faith"
  description="The Statement of Faith of Bethesda Baptist Church, Kathmandu."
>
  <section class="relative isolate overflow-hidden py-16 text-center text-white">
    <Image
      src={bannerImage}
      alt="An open Bible"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      widths={[640, 1600]}
      sizes="100vw"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-stone-900/85 via-stone-900/65 to-stone-900/40"></div>
    <h1 class="text-3xl font-bold sm:text-4xl">Statement of Faith</h1>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-14">
    <p class="text-stone-600">
      What we believe about Scripture, God, salvation, and the church — the
      convictions that shape our life together as a congregation.
    </p>
    <div class="prose prose-stone mt-6 max-w-none prose-h2:text-lg prose-h2:font-semibold">
      <Content />
    </div>
    <a href="/covenant/" class="mt-10 inline-block text-sm underline">Read our Church Covenant &rarr;</a>
  </section>
</BaseLayout>
