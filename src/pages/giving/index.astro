---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT } from '../../lib/site';
import bannerImage from '../../assets/images/giving-praying-hands.jpg';

const ways = [
  {
    title: 'In Person',
    body: 'Give during a Sunday service, or hand your gift directly to Pastor Hari KC or a deacon.',
  },
  {
    title: 'Bank Transfer',
    body: 'Bank account details are being finalized — check back soon or contact us for the current information.',
  },
  {
    title: 'Online',
    body: "We're working on an online giving option. This page will be updated once it's ready.",
  },
];
---

<BaseLayout
  lang="en"
  title="Giving"
  description="Support the ministry of Bethesda Baptist Church, Kathmandu."
>
  <section class="relative isolate overflow-hidden py-16 text-center text-white">
    <Image
      src={bannerImage}
      alt="Praying hands"
      class="absolute inset-0 -z-10 h-full w-full object-cover [object-position:50%_38%]"
      widths={[640, 1200]}
      sizes="100vw"
    />
    <div class="absolute inset-0 -z-10 bg-stone-900/70"></div>
    <h1 class="text-3xl font-bold sm:text-4xl">Giving</h1>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-14">
    <blockquote class="border-l-2 border-stone-300 pl-4 text-stone-600 italic">
      "We covenant to give cheerfully and faithfully of our time, abilities, and
      resources for the support of the ministry, the care of the needy, and the
      spread of the gospel to all nations."
      <footer class="mt-1 text-sm not-italic text-stone-500">— from our Church Covenant</footer>
    </blockquote>

    <h2 class="mt-10 text-lg font-semibold text-stone-900">Ways to Give</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {ways.map((way) => (
        <div class="rounded border border-stone-200 p-5">
          <h3 class="font-semibold text-stone-900">{way.title}</h3>
          <p class="mt-1 text-sm text-stone-600">{way.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 text-sm text-stone-500">
      Questions about giving? Contact us at <a href={`mailto:${CONTACT.email}`} class="underline">{CONTACT.email}</a>.
    </p>
  </section>
</BaseLayout>
