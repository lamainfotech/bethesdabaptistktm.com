---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExampleNotice from '../../components/ExampleNotice.astro';
import { CONTACT } from '../../lib/site';
import bannerImage from '../../assets/images/hero-kathmandu.jpg';

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(CONTACT.mapsQuery)}`;
const mapsEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(CONTACT.mapsQuery)}&output=embed`;

const schedule = [
  { name: 'Saturday Bible Study', time: '9:00 AM' },
  { name: 'Saturday Worship', time: '10:00 AM' },
  { name: 'Wednesday Prayer Meeting', time: '6:00 PM' },
];
---

<BaseLayout
  lang="en"
  title="Service Times & Location"
  description="Service times and location for Bethesda Baptist Church in Dhumbarahi, Kathmandu."
>
  <section class="relative isolate overflow-hidden py-16 text-center text-white">
    <Image
      src={bannerImage}
      alt="View over Kathmandu valley"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      widths={[640, 1600]}
      sizes="100vw"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-stone-900/85 via-stone-900/65 to-stone-900/40"></div>
    <h1 class="text-3xl font-bold sm:text-4xl">Service Times &amp; Location</h1>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-14">
    <h2 class="text-lg font-semibold text-stone-900">Weekly Schedule</h2>
    <ExampleNotice lang="en" variant="banner">
      <ul class="mt-2 space-y-1">
        {schedule.map((item) => (
          <li class="flex justify-between border-b border-sky-200 py-1 last:border-0">
            <span>{item.name}</span>
            <span class="font-medium">{item.time}</span>
          </li>
        ))}
      </ul>
    </ExampleNotice>

    <h2 class="mt-10 text-lg font-semibold text-stone-900">What to Expect When You Visit</h2>
    <ul class="mt-4 space-y-2 text-stone-700">
      <li>Come as you are — dress is casual, no need to dress up.</li>
      <li>Children and families are welcome at every service.</li>
      <li>Arrive a little early to find parking and settle in before things begin.</li>
    </ul>

    <h2 class="mt-10 text-lg font-semibold text-stone-900">Location</h2>
    <p class="mt-2 text-stone-700">{CONTACT.address}</p>
    <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm underline">
      View on Google Maps &rarr;
    </a>
    <div class="mt-4 overflow-hidden rounded-lg border border-stone-200 shadow-sm">
      <iframe
        src={mapsEmbedSrc}
        width="100%"
        height="320"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Map showing Bethesda Baptist Church location"
      ></iframe>
    </div>
  </section>
</BaseLayout>
