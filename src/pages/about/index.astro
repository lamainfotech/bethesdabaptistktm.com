---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="About Us"
  description="Learn about Bethesda Baptist Church, an independent Baptist congregation in Kathmandu, Nepal."
>
  <section class="mx-auto max-w-3xl px-4 py-14">
    <h1 class="text-3xl font-bold text-stone-900">About Us</h1>

    <p class="mt-6 text-stone-700">
      Bethesda Baptist Church is an independent, autonomous congregation in
      Kathmandu, Nepal, subject only to Jesus Christ as the Head of the Church.
      Our aim is to be biblically rooted, mature in a local community of
      believers, and to seek those outside that community — both locally and
      globally — with character, compassion, courage, and creativity.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      <a href="/beliefs/" class="rounded border border-stone-200 p-5 hover:border-stone-400">
        <h2 class="font-semibold text-stone-900">Statement of Faith</h2>
        <p class="mt-1 text-sm text-stone-600">What we believe about Scripture, God, salvation, and the church.</p>
      </a>
      <a href="/covenant/" class="rounded border border-stone-200 p-5 hover:border-stone-400">
        <h2 class="font-semibold text-stone-900">Church Covenant</h2>
        <p class="mt-1 text-sm text-stone-600">Our shared commitments to God and to one another as a congregation.</p>
      </a>
    </div>

    <div class="mt-12 rounded border border-dashed border-stone-300 p-5 text-sm text-stone-500">
      <p class="font-medium text-stone-700">Coming soon</p>
      <p class="mt-1">Pastor and leadership bios and photos will be added here.</p>
    </div>
  </section>
</BaseLayout>
