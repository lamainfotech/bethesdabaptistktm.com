---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExampleNotice from '../../components/ExampleNotice.astro';
import { CONTACT } from '../../lib/site';
import { MINISTRY_IMAGES } from '../../lib/ministryImages';
import heroImage from '../../assets/images/hero-kathmandu.jpg';
import visitImage from '../../assets/images/about-kathmandu.jpg';

const ministries = (await getCollection('ministries')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  lang="ne"
  title="गृहपृष्ठ"
  description="बेथेस्दा ब्याप्टिष्ट चर्च, धुम्बाराही, काठमाडौंमा रहेको एक स्वतन्त्र ब्याप्टिष्ट मण्डली हो।"
>
  <section class="relative isolate overflow-hidden py-28 text-center text-white">
    <Image
      src={heroImage}
      alt="काठमाडौं उपत्यकाको दृश्य"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      widths={[640, 1200, 2000]}
      sizes="100vw"
    />
    <div class="absolute inset-0 -z-10 bg-stone-900/70"></div>
    <div class="mx-auto max-w-2xl px-4">
      <h1 class="text-3xl font-bold sm:text-4xl">बेथेस्दा ब्याप्टिष्ट चर्च</h1>
      <p class="mt-4 text-stone-200">
        काठमाडौंमा रहेको एक स्वतन्त्र ब्याप्टिष्ट मण्डली, परमेश्वरको वचनको अधिकारमा एकत्रित।
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/ne/visit/" class="rounded bg-white px-5 py-2.5 font-medium text-stone-900 hover:bg-stone-100">
          आराधना समय
        </a>
        <a href="/ne/about/" class="rounded border border-white/50 px-5 py-2.5 font-medium text-white hover:bg-white/10">
          हाम्रो बारे
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-stone-200 bg-stone-50 py-14">
    <div class="mx-auto grid max-w-5xl gap-8 px-4 sm:grid-cols-3">
      <div>
        <h2 class="font-semibold text-stone-900">आराधना समय</h2>
        <p class="mt-2 text-sm text-stone-600">आइतबार आराधना — बिहान १०:०० बजे</p>
        <div class="mt-2"><ExampleNotice lang="ne" /></div>
      </div>
      <div>
        <h2 class="font-semibold text-stone-900">ठेगाना</h2>
        <p class="mt-2 text-sm text-stone-600">{CONTACT.address}</p>
      </div>
      <div>
        <h2 class="font-semibold text-stone-900">विश्वासको वक्तव्य</h2>
        <a href="/ne/beliefs/" class="mt-2 inline-block text-sm underline">हेर्नुहोस्</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14">
    <h2 class="text-center text-2xl font-bold text-stone-900">सेवाहरू</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {ministries.map((ministry) => (
        <a href="/ne/ministries/" class="group overflow-hidden rounded border border-stone-200">
          <Image
            src={MINISTRY_IMAGES[ministry.id]}
            alt=""
            class="h-32 w-full object-cover transition-transform group-hover:scale-105"
            widths={[300, 600]}
            sizes="(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw"
          />
          <div class="p-4">
            <h3 class="font-semibold text-stone-900">{ministry.data.title}</h3>
            <p class="mt-1 text-sm text-stone-600">{ministry.data.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="relative isolate overflow-hidden py-16 text-center text-white">
    <Image
      src={visitImage}
      alt="काठमाडौं सहर दृश्य"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      widths={[640, 1600]}
      sizes="100vw"
    />
    <div class="absolute inset-0 -z-10 bg-stone-900/75"></div>
    <div class="mx-auto max-w-xl px-4">
      <h2 class="text-2xl font-bold">भ्रमणको योजना बनाउनुहोस्</h2>
      <p class="mt-3 text-stone-200">तपाईं यस आइतबार हामीसँग जोडिनुहोस्।</p>
      <a href="/ne/visit/" class="mt-6 inline-block rounded bg-white px-5 py-2.5 font-medium text-stone-900 hover:bg-stone-100">
        आराधना समय र ठेगाना
      </a>
    </div>
  </section>
</BaseLayout>
