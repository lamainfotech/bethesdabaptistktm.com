---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExampleNotice from '../../components/ExampleNotice.astro';
import { CONTACT } from '../../lib/site';
import { useTranslations } from '../../lib/ui';

const t = useTranslations('ne');
const home = (await getEntry('home', 'ne'))!.data;
const ministries = (await getCollection('ministries')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout lang="ne" title={home.title} description={home.description} isHome>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden text-white">
    <Image
      src={home.heroImage}
      alt={home.heroImageAlt}
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      widths={[480, 828, 1080, 1440, 2000]}
      sizes="100vw"
      quality={60}
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-950/90 via-brand-950/65 to-stone-900/30"></div>
    <div class="mx-auto max-w-6xl px-4 pb-36 pt-24 sm:pb-40 sm:pt-32">
      <p class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-stone-900/40 px-3 py-1 text-xs font-medium">
        <span class="h-1.5 w-1.5 rounded-full bg-gold-300"></span>
        {t.common.joinUs} · {home.serviceTimes}
      </p>
      <h1 class="mt-5 max-w-2xl text-4xl font-bold leading-tight sm:text-6xl">{home.heroTitle}</h1>
      <p class="mt-5 max-w-xl text-lg text-stone-200">{home.heroText}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/ne/visit/" class="rounded-lg bg-brand-600 px-6 py-3 font-medium text-white shadow-lg shadow-brand-950/30 transition-colors hover:bg-brand-500">
          {home.heroPrimaryButton}
        </a>
        <a href="/ne/about/" class="rounded-lg border border-white/50 px-6 py-3 font-medium text-white transition-colors hover:bg-white/10">
          {home.heroSecondaryButton}
        </a>
      </div>
    </div>
  </section>

  <!-- Key info card, overlapping the hero -->
  <section class:list={['relative z-10 mx-auto -mt-24 max-w-6xl px-4', { 'mb-20': !home.quote }]}>
    <div class="grid overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-stone-200 md:grid-cols-3">
      <div class="bg-brand-700 p-7 text-white">
        <div class="flex items-center gap-2 text-brand-100">
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd" /></svg>
          <h2 class="text-sm font-semibold uppercase tracking-wider">{home.serviceTimesTitle}</h2>
        </div>
        <p class="mt-3 font-serif text-2xl font-semibold">{home.serviceTimes}</p>
        {home.serviceTimesPlaceholder && <div class="mt-3"><ExampleNotice lang="ne" /></div>}
        {home.serviceTimesLink && <a href="/ne/visit/" class="mt-4 inline-block text-sm font-medium text-gold-300 hover:text-gold-400">{home.serviceTimesLink} &rarr;</a>}
      </div>
      <div class="border-b border-stone-200 p-7 md:border-b-0 md:border-r">
        <div class="flex items-center gap-2 text-brand-700">
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.273 1.765 11.842 11.842 0 00.976.544l.028.014.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd" /></svg>
          <h2 class="text-sm font-semibold uppercase tracking-wider">{home.locationTitle}</h2>
        </div>
        <p class="mt-3 text-lg text-stone-800">{CONTACT.address}</p>
        {home.locationLink && <a href="/ne/contact/" class="mt-4 inline-block text-sm font-medium text-brand-700 hover:text-brand-800">{home.locationLink} &rarr;</a>}
      </div>
      <div class="p-7">
        <div class="flex items-center gap-2 text-brand-700">
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.5 2A1.5 1.5 0 008 3.5V4H5.5A1.5 1.5 0 004 5.5v11A1.5 1.5 0 005.5 18h9a1.5 1.5 0 001.5-1.5v-11A1.5 1.5 0 0014.5 4H12v-.5A1.5 1.5 0 0010.5 2h-1zM6 8h8v1.5H6V8zm0 3h8v1.5H6V11zm0 3h5v1.5H6V14z" /></svg>
          <h2 class="text-sm font-semibold uppercase tracking-wider">{home.beliefsTitle}</h2>
        </div>
        {home.beliefsText && <p class="mt-3 text-stone-700">{home.beliefsText}</p>}
        <a href="/ne/beliefs/" class="mt-4 inline-block text-sm font-medium text-brand-700 hover:text-brand-800">{home.beliefsLink} &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Quote -->
  {home.quote && (
    <section class="mx-auto max-w-3xl px-4 py-20 text-center">
      <svg class="mx-auto h-10 w-10 text-gold-400" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M9.3 24c-2.1 0-3.8-.7-5-2.1C3 20.5 2.4 18.7 2.4 16.5c0-2.6.8-5 2.4-7.2C6.4 7 8.6 5.3 11.4 4l1.3 2c-1.9 1-3.4 2.2-4.4 3.5-1 1.3-1.5 2.6-1.5 3.9 0 .5.2.9.5 1.1.4.2.9.4 1.6.6 1.5.4 2.6 1 3.3 1.8.7.8 1 1.8 1 3 0 1.2-.4 2.2-1.3 2.9-.8.8-1.7 1.2-2.6 1.2zm14.6 0c-2.1 0-3.8-.7-5-2.1-1.3-1.4-1.9-3.2-1.9-5.4 0-2.6.8-5 2.4-7.2C21 7 23.2 5.3 26 4l1.3 2c-1.9 1-3.4 2.2-4.4 3.5-1 1.3-1.5 2.6-1.5 3.9 0 .5.2.9.5 1.1.4.2.9.4 1.6.6 1.5.4 2.6 1 3.3 1.8.7.8 1 1.8 1 3 0 1.2-.4 2.2-1.3 2.9-.8.8-1.7 1.2-2.6 1.2z" /></svg>
      <blockquote class="mt-6 font-serif text-2xl italic leading-relaxed text-stone-800 sm:text-3xl">
        {home.quote}
      </blockquote>
      {home.quoteSource && <p class="mt-5 text-sm font-medium uppercase tracking-wider text-brand-700">{home.quoteSource}</p>}
    </section>
  )}

  <!-- Ministries -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold text-stone-900 sm:text-4xl">{home.ministriesTitle}</h2>
        {home.ministriesText && <p class="mt-3 text-stone-600">{home.ministriesText}</p>}
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {ministries.map((ministry) => (
          <a href="/ne/ministries/" class="group flex flex-col overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-stone-200 transition hover:-translate-y-1 hover:shadow-lg">
            <div class="overflow-hidden">
              <Image
                src={ministry.data.image}
                alt=""
                class="h-44 w-full object-cover transition-transform duration-500 group-hover:scale-105"
                widths={[300, 450, 600]}
                sizes="(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw"
              />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-lg font-semibold text-stone-900">{ministry.data.title}</h3>
              <p class="mt-2 line-clamp-3 text-sm text-stone-600">{ministry.data.summary}</p>
              <span class="mt-auto pt-4 text-sm font-medium text-brand-700 group-hover:text-brand-800">{t.common.learnMore} &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Visit CTA -->
  <section class="relative isolate overflow-hidden text-white">
    <Image
      src={home.visitImage}
      alt={home.visitImageAlt}
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      widths={[480, 828, 1080, 1600]}
      sizes="100vw"
      quality={55}
    />
    <div class="absolute inset-0 -z-10 bg-brand-950/80"></div>
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-20 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl">
        <h2 class="text-3xl font-bold sm:text-4xl">{home.visitTitle}</h2>
        <p class="mt-4 text-lg text-stone-200">{home.visitText}</p>
      </div>
      <a href="/ne/visit/" class="shrink-0 self-start rounded-lg bg-white px-6 py-3 font-medium text-brand-800 shadow-lg transition-colors hover:bg-brand-50 md:self-auto">
        {home.visitButton}
      </a>
    </div>
  </section>
</BaseLayout>
