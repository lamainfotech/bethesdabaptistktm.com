---
import { getCollection } from 'astro:content';
import bannerImage from '../../../assets/images/open-bible.jpg';
import PageHero from '../../../components/PageHero.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ExampleNotice from '../../../components/ExampleNotice.astro';
import SermonList from '../../../components/SermonList.astro';

const sermons = (await getCollection('sermons')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  lang="ne"
  title="प्रवचनहरू"
  description="बेथेस्दा ब्याप्टिष्ट चर्चका प्रवचनहरू।"
>
  <PageHero title="प्रवचनहरू" image={bannerImage} alt="खुला बाइबल" eyebrow="हेर्नुहोस् र सुन्नुहोस्" />

  <section class="mx-auto max-w-3xl px-4 py-14">
    {sermons.length === 0 ? (
      <div class="rounded-lg border border-dashed border-stone-300 p-5 text-stone-600">
        <p class="font-medium text-stone-800">चाँडै आउँदैछ</p>
      </div>
    ) : (
      <>
        <div>
          <ExampleNotice lang="ne" variant="banner">
            <p>यी उदाहरण सूचीहरू हुन् — चाँडै वास्तविक भिडियोहरूले प्रतिस्थापन गरिनेछ।</p>
          </ExampleNotice>
        </div>
        <SermonList lang="ne" sermons={sermons} />
      </>
    )}
  </section>
</BaseLayout>
