---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import bannerImage from '../../assets/images/open-bible.jpg';

const entry = await getEntry('covenant', 'en');
const { Content } = await render(entry!);
---

<BaseLayout
  lang="en"
  title="Church Covenant"
  description="The Church Covenant of Bethesda Baptist Church, Kathmandu."
>
  <section class="relative isolate overflow-hidden py-16 text-center text-white">
    <Image
      src={bannerImage}
      alt="An open Bible"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      widths={[640, 1600]}
      sizes="100vw"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-stone-900/85 via-stone-900/65 to-stone-900/40"></div>
    <h1 class="text-3xl font-bold sm:text-4xl">Church Covenant</h1>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-14">
    <p class="text-stone-600">
      Our shared commitments to God and to one another as a congregation.
    </p>
    <div class="prose prose-stone mt-6 max-w-none prose-h2:text-lg prose-h2:font-semibold">
      <Content />
    </div>
    <a href="/beliefs/" class="mt-10 inline-block text-sm underline">Read our Statement of Faith &rarr;</a>
  </section>
</BaseLayout>
